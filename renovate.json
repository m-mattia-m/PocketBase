{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Zurich",
  "schedule": [
    "* 3-5 * * 6"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "labels": [
    "dependencies"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the PocketBase release pinned by ARG PB_VERSION in the Dockerfile",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "ARG PB_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "pocketbase/pocketbase",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "PocketBase itself - a merge to main triggers the release workflow",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "pocketbase/pocketbase"
      ],
      "commitMessageTopic": "PocketBase",
      "automerge": true
    },
    {
      "description": "Base image and GitHub Actions",
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "github-actions"
      ],
      "automerge": true
    }
  ]
}
